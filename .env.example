# Sky & Paw environment variables.
# Copy to .env (git-ignored) for local runs: `cp .env.example .env`, then fill in what you need.
# Never commit real values. In GitHub Codespaces, set the API keys as Codespaces secrets instead
# (repo Settings -> Secrets and variables -> Codespaces); they arrive as environment variables.
# Everything is optional for T0: `make run` and `make test` work with this file left empty.

# --- Cyberwave (simulation platform) ---
# API key from the Cyberwave dashboard. Secret.
CYBERWAVE_API_KEY=
# Id of the Cyberwave environment that holds the scene, drone and Go2 twins (created in M1).
CYBERWAVE_ENVIRONMENT_ID=
# How twin state reaches the backend: "mqtt" (mqtt.cyberwave.com:8883; Codespaces) or
# "rest" (polling at 2-5 Hz; use where outbound 8883 is blocked). Default: rest.
CW_STATE_SOURCE=
# Cyberwave affect mode, checked by skypaw.sim.guard. Only simulation, sim, mujoco or playground
# are accepted; anything else (live, real-world, real, tele) is refused. Default: simulation.
CW_RUNTIME_MODE=

# --- Sarvam AI (speech, planning LLM, TTS, translation) ---
# API subscription key from the Sarvam dashboard. Secret.
SARVAM_API_KEY=

# --- Access tokens for the consoles ---
# Shared bearer token for the lead console. Secret; pick a long random string.
SKYPAW_LEAD_TOKEN=
# Shared bearer token for team phones. Secret; pick a different long random string.
SKYPAW_TEAM_TOKEN=

# --- Server ---
# "dev" also allows http://localhost:* through CORS; "prod" allows only the GitHub Pages origin
# and *.app.github.dev. Default: dev.
SKYPAW_ENV=
# Log level for the JSON-lines logger (DEBUG, INFO, WARNING, ERROR). Default: INFO.
LOG_LEVEL=
# Directory for SQLite, TTS cache and evidence. Default: /data (make run uses ./data).
DATA_DIR=
# Directory with the built frontend served at /. Default: frontend/dist in the repository.
SKYPAW_FRONTEND_DIST=
# HTTP port. Default: 7860.
PORT=
# Git commit shown by GET /version; set by CI or the Docker build. Default: unknown.
GIT_SHA=

# --- Budget guards for live simulator runs ---
# Hard cap on one simulator session, in seconds. Default: 600.
SIM_MAX_DURATION_S=
# Stop live runs when the Cyberwave credit balance falls below this. Default: 15.
CREDIT_FLOOR=
