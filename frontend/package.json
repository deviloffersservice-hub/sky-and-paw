{
  "name": "skypaw-frontend",
  "private": true,
  "version": "0.1.0",
  "description": "Sky & Paw Ops console shell (Vite + TypeScript)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "smoke": "node tests/smoke.cjs",
    "mock": "node tests/mock-server.mjs",
    "test:e2e": "vite build && node tests/e2e.cjs"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/noto-sans-devanagari": "5.3.0",
    "@fontsource/noto-sans-tamil": "5.3.0",
    "three": "0.169.0"
  },
  "devDependencies": {
    "@playwright/test": "1.47.2",
    "@types/three": "0.169.0",
    "typescript": "5.6.3",
    "vite": "5.4.21",
    "ws": "8.18.0"
  }
}
